msgid ""
"Editing a saved date. Its identifier stays the same so your existing "
"shortcodes keep working."
msgstr ""
"Estás editando una fecha. El identificador se mantiene para que los "
"shortcodes existentes sigan funcionando."

msgid "Editing saved shortcode"
msgstr "Editando shortcode guardado"

msgid "Elapsed time"
msgstr "Tiempo transcurrido"

msgid "End date"
msgstr "Fecha final"

