{
  "name": "alp-plugins/alp-dynamic-time-countdowns",
  "description": "Free WordPress countdown timer and dynamic dates plugin with 20 designs, anniversary counters, reusable shortcodes, Gutenberg and Divi 5 support.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "AlpDynamicTime\\": "src/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs --standard=WordPress alp-dynamic-time.php uninstall.php src/ includes/",
    "phpstan": "phpstan analyse"
  }
}
